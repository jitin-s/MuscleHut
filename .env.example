# Supabase public browser configuration.
# Never put the service-role key in frontend files.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Vercel/server-only secret. Keep this out of source control and browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-in-vercel-only
